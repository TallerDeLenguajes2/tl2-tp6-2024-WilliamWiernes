@{
    ViewData["Title"] = "Eliminar Cliente";
}

@model Cliente

<div class="mb-3 d-flex justify-content-center">
    <form asp-controller="Cliente" asp-action="EliminarCliente" autocomplete="off" class="card bg-dark border-secondary p-4"
        style="max-width: 500px; width: 100%;">
        <input type="hidden" asp-for="IdCliente">
        <h2 class="text-center text-light">Eliminar Cliente</h2>
        <div class="mb-3 text-center text-white">
            <p>¿Elimar cliente con id: @Model.IdCliente?</p>
        </div>
        <div class="text-center">
            <button type="submit" class="btn btn-danger w-50 efecto-hover">
                <i class="far fa-trash"></i>
            </button>
        </div>
    </form>
</div>